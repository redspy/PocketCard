; Engine configuration file.
config_version=5

[application]

config/name="PocketCard 덱 뷰어"
config/description="코리안리그 우승 덱 구성을 구경하는 앱"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.055, 0.15, 0.115, 1)
boot_splash/show_image=true
boot_splash/image="res://assets/splash.png"
boot_splash/fullsize=false
boot_splash/use_filter=true

[autoload]

DeckData="*res://scripts/deck_data.gd"
ImageCache="*res://scripts/image_cache.gd"
Nav="*res://scripts/nav.gd"
PerfLog="*res://scripts/perf_log.gd"
Net="*res://scripts/net.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1560
window/size/window_width_override=400
window/size/window_height_override=860
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[importer_defaults]

texture={
"compress/mode": 1,
"compress/lossy_quality": 0.9,
"mipmaps/generate": false
}

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.06, 0.16, 0.12, 1)
